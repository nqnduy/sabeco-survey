</style>
<script is:inline>
	const DEPLOYMENTURI = 'AKfycbwImvV7fiJWbX7fPYZ0m0P96aNKLeQKj1yDEgm6d3gOq99E0HaRkpqETkZd8CkVw-dVnA';
	const form = document.querySelector("#form");
	const submitButton = document.querySelector("#submit");
	let currStep = 1;
	let lastStep = 13;

	form?.addEventListener("submit", async function(event) {
		console.log("event")
		event.preventDefault();
		const formData = new FormData(form);
		const data = Object.fromEntries(formData);
		currStep++;
		updateScreen();
		// submitButton.disabled = true;

		try {
			const response = await fetch(`https://script.google.com/macros/s/${DEPLOYMENTURI}/exec`, {
				method: "POST",
				body: new URLSearchParams(data)
			});
			const responseText = await response.text();
			// alert(responseText);
			// submitButton.disabled = false;
			document.querySelector(`[data-step='${lastStep}']`).classList.add('success');
			form.reset();
		}
		catch (error) {
			alert(error);
			// submitButton.disabled = false;
		}
	});
	function updateInputRangeLabel(input) {
		const value = input.value;
		const min = input.min;
		const max = input.max;
		const label = input.nextElementSibling;

		const percent = ((value - min) / (max - min)) * 100;

		const sliderWidth = input.offsetWidth;
		const thumbSize = label.offsetWidth;
		const availableWidth = sliderWidth - thumbSize;
		const thumbPosition = (percent / 100) * availableWidth + (thumbSize / 2) + 2;
		label.style.left = thumbPosition + 'px';
		label.textContent = value;
	}
	document.querySelectorAll('input[type="range"]').forEach(input => {
		input.addEventListener ("input", (e) => updateInputRangeLabel(e.target));
	})

	const updateScreen = () => {
		// let currStep = document.querySelector('[data-curr-step]').getAttribute('data-curr-step');
		document.querySelectorAll('[data-step]').forEach(step => {
			if (step.getAttribute('data-step') == currStep) {
				step.classList.add('active');
				step.querySelector('input[type="range"]') && updateInputRangeLabel(step.querySelector('input[type="range"]'));
			}
			else {
				step.classList.remove('active');
			}
		})
		document.querySelector('.wrapper-inner').classList[(currStep == 1 || currStep == lastStep) ? 'remove' : 'add']('move-step');
		document.querySelector('.nav').classList[(currStep == 1 || currStep == lastStep) ? 'remove' : 'add']('active');
		document.querySelector('.form-control').classList[(currStep == 1 || currStep == lastStep) ? 'remove' : 'add']('active');
		document.querySelectorAll('.nav-item').forEach((el, idx) => {
			if (idx == currStep - 2) {
				el.classList.add('active');
			}
			else {
				el.classList.remove('active');
			}
		})

		document.querySelector('.form-control-next [data-text-vi]').innerHTML = (currStep < (lastStep - 1)) ? 'Tiếp tục' : 'Hoàn thành';
		document.querySelector('.form-control-next [data-text-en]').innerHTML = (currStep < (lastStep - 1)) ? 'Next' : 'Done';
		document.querySelector('.form-control-next').classList[(currStep < (lastStep - 1)) ? 'remove' : 'add']('submit')

		document.querySelector('.form').classList[(currStep == 1 || currStep == lastStep) ? 'remove' : 'add']('active')
	}
	updateScreen();
	document.querySelector('.btn-start').addEventListener('click', function (e) {
		if (currStep > 1) return;
		e.preventDefault();
		currStep++;
		updateScreen();
	})
	document.querySelector('.form-control-prev').addEventListener('click', function(e) {
		if (currStep <= 1) return;

		e.preventDefault();
		currStep--;
		updateScreen();
	})

	document.querySelector('.form-control-next').addEventListener('click', function(e) {
		if (currStep >= lastStep - 1) return;
		e.preventDefault();
		currStep++;
		updateScreen();
	})
</script>
